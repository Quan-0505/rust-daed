+fn update_lpm_elem_with_oom_retry(
+    map: &ValidatedRuntimeMapHandle,
+    key: &[u8],
+    value: &[u8],
+) -> io::Result<()> {
+    const MAX_ENOMEM_RETRIES: usize = 8;
+    const MAX_DELAY: Duration = Duration::from_millis(50);
+    let mut delay = Duration::from_millis(2);
+    for attempt in 0..=MAX_ENOMEM_RETRIES {
+        match map.update_elem_bytes(key, value) {
+            Ok(()) => return Ok(()),
+            Err(error)
+                if error.raw_os_error() == Some(libc::ENOMEM) && attempt < MAX_ENOMEM_RETRIES =>
+            {
+                // The kernel refills its per-CPU BPF memory cache asynchronously.
+                // A short bounded backoff allows that refill to complete without
+                // turning a transient allocation miss into a failed config load.
+                thread::sleep(delay);
+                delay = delay.saturating_mul(2).min(MAX_DELAY);
+            }
+            Err(error) => return Err(error),
+        }
+    }
+    unreachable!("bounded ENOMEM retry loop always returns")
+}
